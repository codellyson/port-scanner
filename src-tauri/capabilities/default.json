{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the desktop tray app (dev — invokes local `node`).",
  "windows": [],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "name": "node", "cmd": "node", "args": true }
      ]
    },
    {
      "identifier": "shell:allow-kill",
      "allow": [
        { "name": "node", "cmd": "node", "args": true }
      ]
    },
    "opener:default",
    "opener:allow-open-url"
  ]
}
