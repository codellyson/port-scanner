{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Port Scanner",
  "version": "1.0.9",
  "identifier": "com.codellyson.portscanner",
  "build": {
    "beforeBuildCommand": "npm run build && npm run package:sidecar",
    "beforeDevCommand": "npm run build && npm run package:sidecar",
    "frontendDist": "../src/web/public"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "externalBin": [
      "binaries/ports-server"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkyOTk1QjczNDRFODJDMwpSV1REZ2s0MHQ1VXBDU2FWWHdDRFVwS2l5TmVYMmRsZ2VBTCtZc2lSZkJnQ2RNU0lmdytxL2Mycwo=",
      "endpoints": [
        "https://github.com/codellyson/port-scanner/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
