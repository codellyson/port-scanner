{
  "name": "port-scanner-cli",
  "version": "1.0.8",
  "private": true,
  "description": "Personal port utility + self-hosted tunnel edge. Not published.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ports": "./dist/index.js",
    "port-scanner": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && cp -r src/web/public dist/web/",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "web": "node dist/index.js web",
    "web:demo": "DEMO_MODE=true node dist/index.js web",
    "package:sidecar": "node scripts/package-sidecar.js",
    "tauri": "cargo tauri",
    "tauri:dev": "cargo tauri dev",
    "tauri:build": "cargo tauri build",
    "prepublishOnly": "npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "pkg": {
    "assets": [
      "dist/web/public/**/*"
    ],
    "scripts": [
      "dist/**/*.js"
    ]
  },
  "keywords": [
    "port",
    "scanner",
    "network",
    "cli",
    "monitoring",
    "ports",
    "netstat",
    "ss",
    "process",
    "dashboard",
    "web"
  ],
  "author": "codellyson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codellyson/port-scanner.git"
  },
  "bugs": {
    "url": "https://github.com/codellyson/port-scanner/issues"
  },
  "homepage": "https://github.com/codellyson/port-scanner#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^14.0.3",
    "express": "^5.2.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.1",
    "@types/ws": "^8.18.1",
    "@yao-pkg/pkg": "^6.20.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
